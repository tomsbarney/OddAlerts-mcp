# Copy this file to .env and fill in your token.
# Your token is on https://oddalerts.com/football-data-api
ODDALERTS_API_TOKEN=paste-your-token-here

# Only needed when hosting the server for the Claude app (python server.py --http).
# Pick a long random string; your connector URL becomes https://<host>/<secret>/mcp
MCP_PATH_SECRET=
